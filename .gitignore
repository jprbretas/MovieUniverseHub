# Segredos: o .env NUNCA vai para o repositório (só o .env.example)
.env

# Ambiente virtual Python (≈ pastas bin/ e obj/ do .NET: gera-se localmente)
.venv*/
venv/

# Cache do Python e das ferramentas
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Base de dados local (é criada pela aplicação)
dados/*.db
dados/*.db-journal
# Exportações (python -m movieuniverse exportar): são dados dos utilizadores, não código
dados/exportacao*.json

# Pastas dos editores (VS Code, Visual Studio, JetBrains). Do VS Code só se partilharia
# o launch.json (configuração do F5), se existir.
.idea/
.vs/
.vscode/*
!.vscode/launch.json
