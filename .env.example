# Copia este ficheiro para ".env" e preenche os valores.
# O .env está no .gitignore e NUNCA deve ir para o repositório.

# TMDB > Settings > API > "API Read Access Token" (o token longo, não a "API Key" curta)
TMDB_API_TOKEN=

# Opcionais (por omissão: 127.0.0.1, 8000, recarregar ao gravar um .py e o ficheiro dados/movieuniverse.db)
HOST=
PORT=
RELOAD=
DATABASE_URL=
